# Postgres/Supabase connection string. Defaults to local SQLite if unset.
# Production project: supabase.com/dashboard/project/wwxlzvfxlfuodikcamlq
#
# Use the Supavisor pooler (IPv4), NOT the direct db.<ref>.supabase.co
# connection — that one is IPv6-only, which several hosts (Render, Vercel,
# GitHub Actions) can't reach at all:
# postgresql://postgres.wwxlzvfxlfuodikcamlq:<db-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Accounts + magic-link login (Supabase Auth) and monitored-target
# encryption. See README "Accounts and monitoring".
#
# Project API URL and anon key: supabase.com/dashboard/project/wwxlzvfxlfuodikcamlq/settings/api
SUPABASE_URL=https://wwxlzvfxlfuodikcamlq.supabase.co
SUPABASE_ANON_KEY=

# Fernet key (Fernet.generate_key()) used to encrypt a monitored
# DNI/NIE/matrícula at rest. Must be the SAME value on Render and in the
# check_targets.yml GitHub secret — a value encrypted with one key can't be
# decrypted with another. Losing this key makes every monitored target
# unreadable (there's no recovery), so keep a copy somewhere safe.
TARGET_ENCRYPTION_KEY=

# Comma-separated emails allowed into admin.html / /api/admin/* (a logged-in
# user whose email isn't here gets a 403, not a redirect). Must match the
# email they log into Vigila with (Supabase Auth), not any other account.
ADMIN_EMAILS=

# Resend — sends the "you were fined" alert email when a monitored target
# gets a new match (app/email.py, called from app/monitoring.py). Separate
# from Supabase Auth's own mailer, which only sends login emails. Also set
# as a GitHub Actions secret on check_targets.yml, since that cron is what
# finds most new matches.
RESEND_API_KEY=
EMAIL_FROM=VigilaMultas <noreply@vigilamultas.com>

# Stripe — monthly subscription billing (app/billing.py). STRIPE_SECRET_KEY
# is the live/test secret key; STRIPE_WEBHOOK_SECRET is the signing secret
# for the webhook endpoint registered at .../api/billing/webhook (Stripe
# dashboard → Developers → Webhooks). The two price ids are the recurring
# monthly Prices behind the Individual/Familiar plans (Products → Pricing).
# Only the web API needs these — the GitHub Actions crons don't touch billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INDIVIDUAL=
STRIPE_PRICE_ID_FAMILIAR=

# GitHub PAT (fine-grained, "Actions: read and write" on lukas612/vigila
# only) used by the admin "Rellenar días que falten" button to fire
# workflow_dispatch on daily_stats.yml instead of crawling PDFs in-process
# (that in-process version OOM'd the Render web service). Without this set,
# POST /api/admin/backfill-stats returns a 500 instead of falling back to
# the dangerous in-process crawl.
GITHUB_ACTIONS_TOKEN=

# Optional: a billing_portal.configuration id (Stripe dashboard or API —
# see README "Billing (Stripe)") that lets a customer switch between the
# Individual/Familiar prices from the portal, not just cancel. Without
# this, create_portal_session falls back to the account's default
# configuration, which is cancel/payment-method-only unless you've set
# one of your configurations as default with subscription_update enabled.
STRIPE_PORTAL_CONFIGURATION_ID=

# Fase 2 (not wired up yet — see README "What's NOT implemented yet")
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
