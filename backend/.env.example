# Postgres/Supabase connection string. Defaults to local SQLite if unset.
# Production project: supabase.com/dashboard/project/wwxlzvfxlfuodikcamlq
#
# Use the Supavisor pooler (IPv4), NOT the direct db.<ref>.supabase.co
# connection — that one is IPv6-only, which several hosts (Render, Vercel,
# GitHub Actions) can't reach at all:
# postgresql://postgres.wwxlzvfxlfuodikcamlq:<db-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Accounts + magic-link login (Supabase Auth) and monitored-target
# encryption. See README "Accounts and monitoring".
#
# Project API URL and anon key: supabase.com/dashboard/project/wwxlzvfxlfuodikcamlq/settings/api
SUPABASE_URL=https://wwxlzvfxlfuodikcamlq.supabase.co
SUPABASE_ANON_KEY=

# Fernet key (Fernet.generate_key()) used to encrypt a monitored
# DNI/NIE/matrícula at rest. Must be the SAME value on Render and in the
# check_targets.yml GitHub secret — a value encrypted with one key can't be
# decrypted with another. Losing this key makes every monitored target
# unreadable (there's no recovery), so keep a copy somewhere safe.
TARGET_ENCRYPTION_KEY=

# Comma-separated emails allowed into admin.html / /api/admin/* (a logged-in
# user whose email isn't here gets a 403, not a redirect). Must match the
# email they log into Vigila with (Supabase Auth), not any other account.
ADMIN_EMAILS=

# Fase 2 (not wired up yet — see README "What's NOT implemented yet")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INDIVIDUAL=
STRIPE_PRICE_ID_FAMILIAR=
EMAIL_PROVIDER_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
